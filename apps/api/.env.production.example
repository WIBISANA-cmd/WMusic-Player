# Backend Production Server Configuration
PORT=4000
NODE_ENV=production
CORS_ORIGIN=https://music.example.com

# Active Media Provider ('local' | 's3' | 'cdn')
MEDIA_PROVIDER=local
MEDIA_STORAGE_PATH=/app/media

# S3 / MinIO / Cloudflare R2 Provider (When MEDIA_PROVIDER=s3)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=music-catalog-production
S3_ACCESS_KEY=your-production-r2-access-key
S3_SECRET_KEY=your-production-r2-secret-key
S3_REGION=auto

# CDN Token Provider (When MEDIA_PROVIDER=cdn)
CDN_BASE_URL=https://cdn.pulse-music.com/audio
CDN_TOKEN_SECRET=your-secure-production-cdn-hmac-secret

