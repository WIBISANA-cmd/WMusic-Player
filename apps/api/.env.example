# Backend Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Active Media Provider ('local' | 's3' | 'cdn')
MEDIA_PROVIDER=local
MEDIA_STORAGE_PATH=./media

# S3 / MinIO / Cloudflare R2 Provider (Optional if MEDIA_PROVIDER=s3)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=music-catalog
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# CDN Token Provider (Optional if MEDIA_PROVIDER=cdn)
CDN_BASE_URL=https://cdn.pulse-music.internal/audio
CDN_TOKEN_SECRET=pulse-media-secret-token

