# Environment for the root docker-compose.yml (Dokploy > Compose > Environment)

# Public URL of the app, without trailing slash. Required.
CORS_ORIGIN=https://music.example.com

# Leave empty so the browser calls /api on the same domain (recommended).
# Build-time value: redeploy after changing it.
NEXT_PUBLIC_API_URL=

# Optional: enables YouTube search
YOUTUBE_API_KEY=

# Media provider: local | s3 | cdn
MEDIA_PROVIDER=local

# Only when MEDIA_PROVIDER=s3
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# Only when MEDIA_PROVIDER=cdn
CDN_BASE_URL=
CDN_TOKEN_SECRET=
