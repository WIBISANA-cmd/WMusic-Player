{
  "name": "music-app",
  "version": "1.0.0",
  "private": true,
  "description": "Production-oriented mobile-first music web application",
  "scripts": {
    "dev": "pnpm --parallel --filter @music/web --filter @music/api dev",
    "dev:web": "pnpm --filter @music/web dev",
    "dev:api": "pnpm --filter @music/api dev",
    "build": "pnpm --filter @music/shared build && pnpm --filter @music/api build && pnpm --filter @music/web build",
    "start": "pnpm --filter @music/api start",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "pnpm --recursive lint",
    "test": "pnpm --recursive test"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
